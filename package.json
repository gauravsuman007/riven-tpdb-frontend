        "@sjsf/sveltekit": "^3.5.0",
        "ajv": "^8.18.0",
        "ajv-formats": "^3.0.1",
        "better-auth": "^1.6.5",
        "better-sqlite3": "^12.9.0",
        "consola": "^3.4.2",
        "d3-shape": "^3.2.0",
        "drizzle-orm": "^0.45.2",
        "embla-carousel-autoplay": "^8.6.0",
        "mode-watcher": "^1.1.0",
        "nprogress": "^0.2.0",
        "zod": "^4.3.6"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "better-sqlite3",
            "esbuild"
        ],
        "overrides": {
            "cookie": "^0.7.0"
        }
    }
}
