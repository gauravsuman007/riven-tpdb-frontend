{
    "name": "riven-frontend",
    "private": true,
    "version": "1.0.0-beta.3",
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "ba:generate": "pnpx @better-auth/cli generate --config ./better-auth.config.ts --output ./src/lib/server/schema/ba-auth.ts --yes",
        "db:generate": "drizzle-kit generate",
        "db:pull": "tsx ./scripts/drizzle_pull.ts",
        "db:studio": "drizzle-kit studio",
        "generate": "graphql-codegen --config codegen.ts"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.5",
        "@eslint/js": "^10.0.1",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@fontsource/merriweather": "^5.2.11",
        "@fontsource/oxanium": "^5.2.8",
        "@lucide/svelte": "^1.8.0",
        "@sveltejs/adapter-node": "^5.5.4",
        "@sveltejs/kit": "^2.57.1",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/d3-shape": "^3.1.8",
        "@types/node": "^25.6.0",
        "@types/nprogress": "^0.2.3",
        "@zxcvbn-ts/core": "^3.0.4",
        "@zxcvbn-ts/language-common": "^3.0.4",
        "@zxcvbn-ts/language-en": "^3.0.2",
        "bits-ui": "^2.18.0",
        "clsx": "^2.1.1",
        "country-flag-icons": "^1.6.16",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "embla-carousel-svelte": "^8.6.0",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.0",
        "formsnap": "^2.0.1",
        "globals": "^17.5.0",
        "layerchart": "2.0.0-next.27",
        "mdsvex": "^0.12.7",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "runed": "^0.37.1",
        "svelte": "^5.55.4",
        "svelte-check": "^4.4.6",
        "svelte-confetti": "^2.3.2",
        "svelte-sonner": "^1.1.0",
        "svelte-tel-input": "^4.0.2",
        "svelte-toolbelt": "^0.10.6",
        "sveltekit-superforms": "^2.30.1",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.2.2",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.58.2",
        "vaul-svelte": "1.0.0-next.7",
        "vite": "^8.0.8"
    },
    "dependencies": {
        "@better-auth/passkey": "^1.6.5",
        "@internationalized/date": "^3.12.1",
        "@sjsf/ajv8-validator": "^3.5.0",
        "@sjsf/form": "^3.5.0",
